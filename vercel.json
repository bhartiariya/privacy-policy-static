{
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/bhajan/:id", "destination": "/redirect.html" },
    { "source": "/playlist/:id", "destination": "/redirect.html" },
    { "source": "/album/:id", "destination": "/redirect.html" },
    { "source": "/artist/:id", "destination": "/redirect.html" },
    { "source": "/user-playlist/:id", "destination": "/redirect.html" },
    { "source": "/user/:id", "destination": "/redirect.html" }
  ]
}
